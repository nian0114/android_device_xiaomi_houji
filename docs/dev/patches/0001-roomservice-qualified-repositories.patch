From 8723173b29cd7f8abcb257073560bd7a9fcad92b Mon Sep 17 00:00:00 2001
From: nian0114 <268078545@qq.com>
Date: Mon, 16 Nov 2026 10:36:40 +0800
Subject: [PATCH] fix roomservice: support qualified dependency repositories

Device dependencies may live in personal or vendor GitHub namespaces. Preserve explicit owner/repository names and remote selections while keeping unqualified names under LineageOS.

Change-Id: I0ceb0972a50b42d4555214ad14901c452a62d3e3
---
 build/tools/roomservice.py | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/build/tools/roomservice.py b/build/tools/roomservice.py
index 15b727a8..0c660a57 100755
--- a/build/tools/roomservice.py
+++ b/build/tools/roomservice.py
@@ -207,19 +207,24 @@ def add_to_manifest(dependencies):
             lm.append(include)
         elif dependency_type == 'project':
             repo_name = dependency['repository']
+            if (
+                dependency.get('remote', 'github') == 'github'
+                and '/' not in repo_name
+            ):
+                repo_name = f'LineageOS/{repo_name}'
             repo_target = dependency['target_path']
             repo_revision = dependency['branch']
             print(f'Checking if {repo_target} is fetched from {repo_name}')
             if is_in_manifest('project', 'path', repo_target):
-                print(f'LineageOS/{repo_name} already fetched to {repo_target}')
+                print(f'{repo_name} already fetched to {repo_target}')
                 continue
 
             project = ElementTree.Element(
                 'project',
                 attrib={
                     'path': repo_target,
-                    'remote': 'github',
-                    'name': f'LineageOS/{repo_name}',
+                    'remote': dependency.get('remote', 'github'),
+                    'name': repo_name,
                     'revision': repo_revision,
                 },
             )
@@ -314,6 +319,8 @@ def fetch_dependencies(repo_path):
 
 
 def get_default_or_fallback_revision(repo_name):
+    if '/' not in repo_name:
+        repo_name = f'LineageOS/{repo_name}'
     default_revision = get_default_revision()
     print(f'Default revision: {default_revision}')
     print('Checking branch info')
@@ -324,7 +331,7 @@ def get_default_or_fallback_revision(repo_name):
                 'git',
                 'ls-remote',
                 '-h',
-                'https://:@github.com/LineageOS/' + repo_name,
+                'https://:@github.com/' + repo_name,
             ],
             stdout=subprocess.PIPE,
             stderr=subprocess.PIPE,
-- 
